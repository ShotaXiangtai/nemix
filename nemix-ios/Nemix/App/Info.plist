<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>ja_JP</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>nemix</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>im.nemix.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>nemix</string>
            </array>
        </dict>
    </array>
    <key>CFBundleDisplayName</key>
    <string>nemix</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>
    <key>NSBonjourServices</key>
    <array>
        <string>_nemix-p2p._tcp</string>
        <string>_nemix-p2p._udp</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
    </array>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Bluetooth Low Energyメッシュにより、インターネット圏外でも近くの端末と直接P2P暗号化通信を行うために使用します。</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>周辺の端末へ暗号化パケットを直接中継するために使用します。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Wi-Fiおよびローカルネットワークを通じて、中央サーバーなしで直接端末同士をP2P接続するために使用します。</string>
    <key>NSCameraUsageDescription</key>
    <string>連絡先交換やグループ参加のQRコードをスキャンするためにカメラを使用します。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>高音質・低遅延のP2P暗号化音声通話のためにマイクを使用します。</string>
</dict>
</plist>

